# Servidor Express
PORT=3000
NODE_ENV=development

# Database (PostgreSQL via Docker Compose)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/callvu_agenda?schema=public"

# Google Calendar API (OAuth2)
GOOGLE_CLIENT_ID="tu_google_client_id"
GOOGLE_CLIENT_SECRET="tu_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/oauth2callback"

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN="callvu_secret_verify_token_2026"
WHATSAPP_PHONE_NUMBER_ID="tu_phone_number_id_meta"
WHATSAPP_API_TOKEN="tu_system_user_access_token_meta"
